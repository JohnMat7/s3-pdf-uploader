# ==============================================================================
# ENVIRONMENT CONFIGURATION FOR PDF MANAGEMENT SYSTEM
# ==============================================================================

# Storage provider: 's3' for AWS S3 production/staging or 'minio' for local development
STORAGE_PROVIDER=s3

# ------------------------------------------------------------------------------
# AWS S3 Settings
# ------------------------------------------------------------------------------
# NOTE: In AWS EC2, leave AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY blank if 
# using IAM Roles assigned to the EC2 Instance Profile (Best Practice).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=my-pdf-documents-bucket

# Set only if using local MinIO or custom S3 compatible endpoint (e.g., http://minio:9000)
# S3_ENDPOINT_URL=

# ------------------------------------------------------------------------------
# PostgreSQL / Amazon RDS Settings
# ------------------------------------------------------------------------------
# Format: postgresql://<user>:<password>@<rds-endpoint>:5432/<database_name>
DATABASE_URL=postgresql://postgres:YourSecurePasswordHere@my-rds-postgres.c123456789.us-east-1.rds.amazonaws.com:5432/pdf_management

# ------------------------------------------------------------------------------
# Local Fallbacks & Uploads
# ------------------------------------------------------------------------------
UPLOAD_DIRECTORY=upload_pdf

# MinIO backwards compatibility (when STORAGE_PROVIDER=minio)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=company-documents
MINIO_SECURE=false
